# Copy to .env (deploy.sh does this for you and fills TI_SECRET).

# Session-signing secret. Keep it long and private. Generate with:
#   openssl rand -hex 32
TI_SECRET=

# Port the panel listens on (inside the container / on the host for node mode).
PORT=8787

# Only needed for automatic HTTPS (docker compose --profile tls).
# Point this domain's DNS A record at your server first.
DOMAIN=
