<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / iisnode config for hosting the panel on Windows shared hosting
  (e.g. SharkASP.NET "Node.js App"). Zero npm dependencies, so nothing to
  install - just upload the files and point the Node.js App entry at
  server/index.js (this web.config sends every request to it).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server/index.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- let iisnode's own debug endpoint through -->
        <rule name="iisnode-debug" stopProcessing="true">
          <match url="^server/index.js/debug[/]?" />
        </rule>
        <!-- everything else -> the Node app (it serves pages, api, setup.sh, /d/…) -->
        <rule name="AllToNode">
          <match url="/*" />
          <action type="Rewrite" url="server/index.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      nodeProcessCountPerApplication="1"
      watchedFiles="web.config;*.js"
      loggingEnabled="true"
      devErrorsEnabled="true" />

    <!-- don't let IIS serve these directly; the Node app handles them -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
